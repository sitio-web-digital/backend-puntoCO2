# Rol dueño de las tablas, con privilegios de DDL. Sólo lo usa Prisma CLI para migraciones
# (prisma migrate ...), nunca la app en runtime. docker-compose local por defecto; en
# producción, connection string de admin de Neon/Supabase.
DATABASE_URL="postgresql://matafuego:matafuego_dev_only@localhost:5436/matafuego_saas?schema=public"

# Rol de la aplicación en runtime: sin privilegios de superusuario, para que Row-Level
# Security se aplique de verdad (ver prisma/migrations/*_app_role_least_privilege).
# Local: correr `npm run db:bootstrap` para crear el rol y fijar esta contraseña.
RUNTIME_DATABASE_URL="postgresql://app_user:app_user_dev_only@localhost:5436/matafuego_saas?schema=public"

# Secreto para firmar JWT de sesión. Generar con: openssl rand -base64 32
AUTH_SECRET="reemplazar-en-.env-nunca-commitear"

# Entorno
NODE_ENV="development"

# Cuenta Twilio de la plataforma (una sola, no por tenant) para el envío de
# WhatsApp (ver src/server/notificaciones/twilio-sender.ts). Opcionales: sin
# ellas el canal WhatsApp falla limpio y cae a EMAIL (RF-19). Se consiguen
# en el dashboard de Twilio (console.twilio.com).
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="reemplazar-nunca-commitear"

# Opcional: mapeo de plantilla interna -> ContentSid de Twilio, para cuando
# haya plantillas de WhatsApp ya aprobadas por Meta. Sin esto, se manda
# texto libre (válido en el sandbox de Twilio).
# TWILIO_WHATSAPP_CONTENT_TEMPLATES='{"vencimiento_proximo":"HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}'
